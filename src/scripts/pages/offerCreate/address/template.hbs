{{#> OfferCreateLayout grey=true}}
<div class="offerCreate__address" id="offerCreateAddressForm">
    <div class="offerCreate__address-form">
        <div class="offerCreate__input offerCreate__address-address">
            <label for="input-address" class="offerCreate__input-label">Адрес</label>
            {{> AddressInput id="input-address" name="offer_address" type="text" placeholder="Город, улица, дом"}}
        </div>
        <div class="offerCreate__input offerCreate__address-floor">
            <label for="input-floor" class="offerCreate__input-label">Этаж</label>
            <div class="offerCreate__address-inputs-floor">
                {{> FilterDoubleInput id="input-floor" name="offer_floor" label="Этаж"}}
            </div>
        </div>
    </div>
    <div class="offerCreate__address-form">
        <div class="offerCreate__input offerCreate__address-address">
            <label for="input-zhk" class="offerCreate__input-label">Жилищный комплекс</label>
            {{> SelectInput listId="input-zhk-list" id="input-zhk" name="offer_zhk" type="text" placeholder="Цветочные поляны"}}
        </div>
        <div class="offerCreate__input offerCreate__address-address">
            <label for="input-metro" class="offerCreate__input-label">Метро</label>
            {{> SelectInput listId="input-metro-list" id="input-metro" name="offer_metro" type="text" placeholder="Бауманская"}}
        </div>
    </div>
    <div id="offerCreateMap" class="offerCreate__address-map"></div>
</div>
{{/ OfferCreateLayout }}