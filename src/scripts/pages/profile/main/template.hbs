{{#> ProfileLayout grey=true}}
    <div class="profile__right-blocks">
        <div class="profile__block">
            <h2 class="profile__block-title">Мои объявления</h2>
            <div id="profileMyOffersPreviews" class="profile__block-previews"></div>
            {{> PrimaryButton class="profile__block-button" id="profileBlockCreateOfferButton" name="Создать первое объявление" }}
            {{> PrimaryButton class="profile__block-button" id="profileBlockMyOffersButton" name="Показать все объявления" }}
        </div>
        <div class="profile__block">
            <h2 class="profile__block-title">Избранное</h2>
            <div id="profileFavoritesPreviews" class="profile__block-previews">
                Список избранных пуст
            </div>
            {{> PrimaryButton class="profile__block-button" id="profileBlockFindOfferButton" name="Найти любимое объявление" }}
            {{> PrimaryButton class="profile__block-button" id="profileBlockFavoritesButton" name="Показать все объявления" }}
        </div>
    </div>
    <div class="profile__right-promotion">
        <h2 class="profile__right-promotion-title">
            Платное продвижение
        </h2>
        <span class="profile__right-promotion-text">
            Подключите платное продвижение, чтобы ваше объявление стало заметнее для потенциальных покупателей или арендаторов. Ваше объявление будет выделяться в поиске и на главной странице, привлекая больше внимания.
        </span>
        {{> PrimaryButton class="profile__right-promotion-btn" id="profileRightPromotionButton" name="Выбрать объявление" }}
    </div>
{{/ProfileLayout}}