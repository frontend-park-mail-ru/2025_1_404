{{#> OfferEditLayout grey=true}}
    <div class="offerCreate__docs">
        <div class="offerCreate__docs-input" id="offerCreateDocsInputBlock">
            <input id="offerCreateDocsInput" type="file" accept=".pdf,.PDF,.doc,.DOC,.docx,.DOCX" multiple>
            {{> PrimaryButton id="offerCreateDocsButton" class="offerCreate__docs-button" name="Выбрать файл"}}
            <span class="offerCreate__docs-label">Или перетащите файл(ы) для загрузки (Форматы: pdf, doc, docx)</span>
        </div>
        <div class="offerCreate__docs-previews" id="offerCreateDocsPreviews">

        </div>
    </div>
{{/ OfferEditLayout }}