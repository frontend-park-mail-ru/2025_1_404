{{#> BaseModal id="promotionModal"}}
    <div class="promotionModal__inner">
        <h3 class="promotionModal__title" id="promotionModal-title">{{promotionButtonTitle}}</h3>
        <div class="promotionModal__choices" id="promotionModal-choices">
            {{> ChoiceButton label="" index="0" name="input-promotion-type" }}
            {{> ChoiceButton label="" index="1" name="input-promotion-type" }}
            {{> ChoiceButton label="" index="2" name="input-promotion-type" }}
        </div>
        <div class="promotionModal__buttons" id="promotionModal-buttons">
            <button class="{{submitButtonClass}}-btn" id="promotionModal-submitButton">{{submitButtonName}}</button>
            <button class="{{denyButtonClass}}-btn" id="promotionModal-denyButton">{{denyButtonName}}</button>
        </div>
    </div>
{{/BaseModal}}